<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_item" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
 <ImageView android:id="@+id/widget_art" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="end" android:scaleType="centerCrop" android:importantForAccessibility="no"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
  <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="top">
   <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical">
    <TextView android:id="@+id/widget_kicker" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="NEXT ASSIGNMENT" android:textSize="9sp" android:letterSpacing="0.12" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/widget_card_brand" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="10sp" android:maxLines="1" android:ellipsize="end"/>
   </LinearLayout>
   <TextView android:id="@+id/widget_badge" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:includeFontPadding="false"/>
  </LinearLayout>
  <TextView android:id="@+id/widget_item_title" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:paddingEnd="72dp" android:fontFamily="sans-serif-black" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp" android:autoSizeMaxTextSize="42sp" android:autoSizeStepGranularity="1sp"/>
  <ImageView android:id="@+id/widget_rule" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginBottom="6dp" android:importantForAccessibility="no"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="35dp" android:orientation="horizontal">
   <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical">
    <TextView android:id="@+id/widget_time_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TIME" android:textSize="8sp" android:letterSpacing="0.1"/>
    <TextView android:id="@+id/widget_item_subtitle" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:includeFontPadding="false"/>
   </LinearLayout>
   <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="12dp">
    <TextView android:id="@+id/widget_role_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ROLE" android:textSize="8sp" android:letterSpacing="0.1"/>
    <TextView android:id="@+id/widget_item_detail" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:includeFontPadding="false"/>
   </LinearLayout>
  </LinearLayout>
 </LinearLayout>
</FrameLayout>