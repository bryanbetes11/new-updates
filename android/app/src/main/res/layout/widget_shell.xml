<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:padding="10dp" android:background="@drawable/widget_light">
 <TextView android:id="@+id/widget_brand" android:layout_width="match_parent" android:layout_height="wrap_content"
 android:text="SERVESYNC" android:textSize="10sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
 <LinearLayout android:id="@+id/widget_heading_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
  <TextView android:id="@+id/widget_heading" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
   android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:paddingTop="3dp" android:paddingBottom="3dp" />
  <TextView android:id="@+id/widget_settings" android:layout_width="44dp" android:layout_height="40dp" android:gravity="center"
   android:text="⚙" android:textSize="18sp" android:contentDescription="Customize widget" android:background="@drawable/widget_ripple" />
 </LinearLayout>
 <ViewFlipper android:id="@+id/widget_flipper" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
  android:inAnimation="@anim/widget_enter" android:outAnimation="@anim/widget_exit" android:animateFirstView="false" android:autoStart="false">
  <LinearLayout android:id="@+id/widget_page_a" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" />
  <LinearLayout android:id="@+id/widget_page_b" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" />
 </ViewFlipper>
 <LinearLayout android:id="@+id/widget_controls" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical">
  <TextView android:id="@+id/widget_refresh" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
   android:gravity="center_vertical" android:textSize="10sp" android:maxLines="2" android:ellipsize="end" android:background="@drawable/widget_ripple" />
  <TextView android:id="@+id/widget_previous" android:layout_width="44dp" android:layout_height="match_parent" android:gravity="center"
   android:text="‹" android:textSize="26sp" android:contentDescription="Previous items" android:background="@drawable/widget_ripple" />
  <TextView android:id="@+id/widget_next" android:layout_width="44dp" android:layout_height="match_parent" android:gravity="center"
   android:text="›" android:textSize="26sp" android:contentDescription="Next items" android:background="@drawable/widget_ripple" />
 </LinearLayout>
</LinearLayout>
