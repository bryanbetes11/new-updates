{
  "name": "servesync",
  "private": true,
  "version": "1.4.20",
  "type": "module",
  "scripts": {
    "test:attendance-privacy": "node tests/privacyInternalNotes.mjs && node tests/leadershipRoleAssignments.mjs && node tests/attendanceTeamMemberships.mjs && node tests/attendanceTeamAccess.mjs && node tests/attendanceReminderPrivacy.mjs",
    "test:android-push": "node tests/nativePushDatabase.mjs && node tests/nativePushDispatch.mjs",
    "test:announcement-reactions": "node tests/announcementReactionNotifications.mjs",
    "test:notification-db": "node tests/notificationDatabase.mjs",
    "test:notification-activity": "node tests/notificationActivityDatabase.mjs && node tests/notificationPushHandoff.mjs && node tests/notificationOpenQueue.mjs",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ignore-pattern \"**/._*\"",
    "preview": "vite preview",
    "test": "tsc --noEmit -p tsconfig.tests.json && node tests/run.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "validate": "npm run test && npm run typecheck && npm run lint && npm run build",
    "mobile:sync:android": "npm run build && cap sync android",
    "mobile:sync:ios": "npm run build && cap sync ios",
    "mobile:open:android": "cap open android",
    "mobile:open:ios": "cap open ios",
    "mobile:doctor": "node scripts/mobile-doctor.mjs",
    "mobile:apk": "node scripts/build-android.mjs --push",
    "mobile:play": "node scripts/build-android.mjs --play",
    "test:attendance-foundation": "node tests/privacyInternalNotes.mjs && node tests/leadershipRoleAssignments.mjs && node tests/attendanceTeamMemberships.mjs",
    "desktop:web": "vite --host 127.0.0.1 --port 5175 --strictPort",
    "desktop:dev": "tauri dev",
    "desktop:build": "node scripts/build-windows.mjs",
    "desktop:build:mac": "node scripts/build-macos.mjs",
    "desktop:info": "tauri info",
    "desktop:test": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/push-notifications": "8.1.2",
    "@phosphor-icons/react": "2.1.10",
    "@supabase/supabase-js": "^2.57.4",
    "@tauri-apps/api": "2.12.2",
    "@tauri-apps/plugin-notification": "2.5.1",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.13.2",
    "chordsheetjs": "^15.2.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "fflate": "0.8.2",
    "framer-motion": "^12.36.0",
    "lucide-react": "^0.344.0",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.13.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.9.1",
    "@tauri-apps/cli": "2.12.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
