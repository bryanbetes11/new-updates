{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run validate",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/share/events/:id/image",
      "destination": "/api/share-event?id=:id&mode=image"
    },
    {
      "source": "/share/events/:id",
      "destination": "/api/share-event?id=:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
